# Copy to .env and fill in. docker-compose reads this file.
DEEP_SEEK_API_KEY=
FIRECRAWL_API_KEY=

# Point the Python code (run_pipeline, export script) at a hosted Postgres such
# as Supabase. Takes priority over the POSTGRES_* values below. Use the
# "Session pooler" connection string, the "postgresql+psycopg2://" scheme, a
# URL-encoded password and sslmode=require, e.g.:
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<PASSWORD>@<host>.pooler.supabase.com:5432/postgres?sslmode=require

# Only needed when running the Python code outside Docker (defaults shown).
# POSTGRES_USER=market_intel
# POSTGRES_PASSWORD=market_intel
# POSTGRES_DB=market_intel
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5433
